# Copy to .env for local development. Never commit the real file.

# Postgres connection. `npm run dev:db` starts one on this URL.
DATABASE_URL=postgres://pantry:pantry@localhost:54329/pantry

PORT=4000

# Volunteers type this PIN to scan items and edit the inventory.
EDIT_PIN=change-me

# Optional. If set, viewing the inventory also needs a PIN (this one or
# EDIT_PIN). Leave empty to let anyone with the link look.
VIEW_PIN=

# Signs the login cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Sent to the barcode lookup services, which ask clients to identify
# themselves. Keep it generic or add a contact address if you want one.
LOOKUP_USER_AGENT=pantry-inventory/0.1
