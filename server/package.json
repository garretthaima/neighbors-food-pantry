    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "^17.5.0-beta.15",
    "supertest": "^7.0.0",
    "typescript": "^5.8.0",
    "vitest": "^5.1.1"
  }
}
