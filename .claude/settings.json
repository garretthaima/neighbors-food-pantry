{
    "permissions": {
        "allow": [
            "Bash(npm run check)",
            "Bash(npm run typecheck)",
            "Bash(npm run lint)",
            "Bash(npm run format:check)",
            "Bash(npm test)",
            "Bash(npm run test:e2e)",
            "Bash(git status *)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(gh issue view *)",
            "Bash(gh issue list *)",
            "Bash(gh pr view *)",
            "Bash(gh pr checks *)"
        ],
        "deny": ["Read(./.env)", "Read(./.env.*)"]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3",
                        "args": [
                            "-I",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_protected_files.py"
                        ],
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3",
                        "args": ["-I", "${CLAUDE_PROJECT_DIR}/.claude/hooks/format_on_edit.py"],
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}
